# Copy to config.env (git-ignored) and fill in. Never commit real values.
# Variables are grouped by who reads them.

# --- Worker: R2 access (set as RunPod endpoint env/secrets; never baked into the image) ---
# Cloudflare account id (32 hex chars); the S3 endpoint is built as
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# R2 API token (S3 credentials) scoped to the one bucket, Object Read & Write
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket holding inputs/ (UI uploads) and outputs/ (worker results)
R2_BUCKET=

# --- Worker: optional tuning (defaults shown; leave unset unless needed) ---
# Generation budget in seconds. Uploads get the rest of the endpoint execution timeout
# (RUNPOD_EXEC_TIMEOUT_MS below, 900 s by default, minus 15 s safety), so keep this at most ~800.
# JOB_TIMEOUT_S=780
# PID file written by the base image's start.sh; the handler fails fast if that process is gone.
# COMFY_PID_FILE=/tmp/comfyui.pid
# Seconds to wait for ComfyUI to accept requests after container start.
# COMFY_READY_TIMEOUT_S=300
# Max size of an input file fetched from R2, in bytes.
# INPUT_MAX_BYTES=524288000
# Where the handler looks for workflow templates on the network volume.
# WORKFLOWS_DIR=/runpod-volume/workflows
# Address of the in-container ComfyUI HTTP API.
# COMFY_HOST=127.0.0.1:8188
# ComfyUI install dir (input/ and output/ are used by the handler).
# COMFY_ROOT=/comfyui
# Seconds between ComfyUI /history polls.
# POLL_INTERVAL_S=1.0
# Base image knobs: NETWORK_VOLUME_DEBUG=true prints volume diagnostics; COMFY_LOG_LEVEL=INFO quiets ComfyUI.
# COMFY_LOG_LEVEL=DEBUG

# --- Build / CI ---
# Local `make build` image name (CI pushes ghcr.io/<owner>/ltx25-worker using GITHUB_TOKEN; no secret needed here).
IMAGE=ghcr.io/ken-ck-yu/ltx25-worker
TAG=dev

# --- Infra (infra/runpod/apply.sh, scripts/smoke-job.sh) ---
# apply.sh reads this file with a fixed-key reader (never `source`), never prints these values,
# and writes the ids below back into it. Keep the file mode 0600.
# RunPod REST API key.
RUNPOD_API_KEY=
# Read-only Hugging Face token (gated Lightricks repo). Only used by `apply.sh pod-up`, which hands it to
# the temp pod as a temporary RunPod secret that `pod-down` deletes. Rotate it afterwards.
HF_TOKEN=
# Worker image: IMAGE (above) + IMAGE_TAG. Must be the CI build's sha-<short> tag (^sha-[0-9a-f]{7,}$);
# latest and anything else is rejected. Build the tag from the merge commit of the worker you want to run
# (the peak_vram_mb change needs a rebuilt image; read the tag from the build-worker run).
# Left empty on purpose: apply.sh (endpoint, preflight) and smoke-job.sh refuse to run with it empty, so nobody
# runs the gate on an old image by copy-paste. sha-f637c09 (the first build) predates peak_vram_mb/EXEC_TIMEOUT_S.
IMAGE_TAG=
# Commit the temp pod checks out before running scripts/download-models.sh. A full 40-hex sha, never a branch
# or HEAD. Default is the main commit that contains download-models.sh and the lock; bump deliberately.
GIT_REF=bb869c52726d9cbc5ec10aa53f3a5ec404c6820c
# Pinned image for the temp CPU pod (bash 5, curl 7.71+, git; explicit non-latest tag). Choose from an image read.
RUNPOD_POD_IMAGE=
# Worker tuning forwarded to the endpoint env by apply.sh: JOB_TIMEOUT_S, COMFY_READY_TIMEOUT_S, INPUT_MAX_BYTES,
# POLL_INTERVAL_S, VRAM_SAMPLE_S (at least 0.2). The other worker knobs above (COMFY_HOST, COMFY_ROOT, COMFY_PID_FILE,
# WORKFLOWS_DIR, ...) are NOT forwarded; they only apply to local runs.
# VRAM_SAMPLE_S=1.0
# Optional pod overrides: RUNPOD_POD_CPU_ID=cpu3c  RUNPOD_POD_VCPU=2  SKIP_MOUNT_CHECK=1 (only after df -hT)
# Inputs with defaults (shown):
# RUNPOD_DC=US-WA-1
# RUNPOD_VOLUME_NAME=jubividia-ltx-us-wa1
# RUNPOD_VOLUME_GB=80
# RUNPOD_ENDPOINT_NAME=jubividia-ltx25
# RUNPOD_WORKERS_MIN=0
# RUNPOD_WORKERS_MAX=2
# RUNPOD_IDLE_TIMEOUT_S=60
# Endpoint execution timeout in MILLISECONDS. 900000 (15 min) is our own spend-safety choice, not a RunPod limit
# (RunPod allows 5 s to 7 days). apply.sh reads it back after every create/patch and passes EXEC_TIMEOUT_S to
# the worker (handler.PLATFORM_LIMIT_S). JOB_TIMEOUT_S + 15 s must stay below it.
# RUNPOD_EXEC_TIMEOUT_MS=900000
# RUNPOD_QUEUE_DELAY_S=4
# RUNPOD_DISK_GB=20
# Written back by apply.sh (leave empty; do not delete the volume id while the volume exists):
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_ENDPOINT_ID=
RUNPOD_POD_ID=
RUNPOD_SECRET_ID_R2_KEY_ID=
RUNPOD_SECRET_ID_R2_KEY_SECRET=
# Base URLs are overridable in the environment, not here: RUNPOD_API_BASE (default https://api.runpod.io/v2, routes
# /account/secrets /network-volumes /serverless /pods) and RUNPOD_RUN_BASE (default https://api.runpod.ai/v2).
# With RUNPOD_TEST_MODE=1 (the offline tests) any URL that is not http://127.0.0.1:* is refused.
