# Copy to config.env (git-ignored) and fill in. Never commit real values.
# Variables are grouped by who reads them.

# --- Worker: R2 access (set as RunPod endpoint env/secrets; never baked into the image) ---
# Cloudflare account id (32 hex chars); the S3 endpoint is built as
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# R2 API token (S3 credentials) scoped to the one bucket, Object Read & Write
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket holding inputs/ (UI uploads) and outputs/ (worker results)
R2_BUCKET=

# --- Worker: optional tuning (defaults shown; leave unset unless needed) ---
# Hard limit for one job in seconds. Must stay below the endpoint execution timeout (900).
# JOB_TIMEOUT_S=840
# Seconds to wait for ComfyUI to accept requests after container start.
# COMFY_READY_TIMEOUT_S=300
# Max size of an input file fetched from R2, in bytes.
# INPUT_MAX_BYTES=524288000
# Where the handler looks for workflow templates on the network volume.
# WORKFLOWS_DIR=/runpod-volume/workflows
# Address of the in-container ComfyUI HTTP API.
# COMFY_HOST=127.0.0.1:8188
# ComfyUI install dir (input/ and output/ are used by the handler).
# COMFY_ROOT=/comfyui
# Seconds between ComfyUI /history polls.
# POLL_INTERVAL_S=1.0
# Base image knobs: NETWORK_VOLUME_DEBUG=true prints volume diagnostics; COMFY_LOG_LEVEL=INFO quiets ComfyUI.
# COMFY_LOG_LEVEL=DEBUG

# --- Build / CI ---
# Local `make build` image name (CI pushes ghcr.io/<owner>/ltx25-worker using GITHUB_TOKEN; no secret needed here).
IMAGE=ghcr.io/ken-ck-yu/ltx25-worker
TAG=dev

# --- Later features (filled in as they land) ---
# HF_TOKEN=            # models: Hugging Face token (gated Lightricks repo)
# RUNPOD_API_KEY=      # endpoint / ui: RunPod API key
# RUNPOD_ENDPOINT_ID=  # endpoint / ui
